{
    "name": "@atomichub/eosio-ship-utils",
    "version": "1.0.0",
    "private": true,
    "description": "EOSIO State History Plugin (SHIP) utilities",
    "main": "./dist/index.js",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "swc-node": "./src/index.ts",
            "require": "./dist/index.js"
        }
    },
    "scripts": {
