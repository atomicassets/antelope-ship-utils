{
    "name": "@atomichub/antelope-ship-utils",
    "version": "1.0.0",
    "description": "State History Plugin (SHIP) client for Antelope chains: connect, deserialize, and consume blocks, traces, and deltas",
    "license": "MIT",
    "homepage": "https://github.com/atomicassets/antelope-ship-utils#readme",
    "bugs": {
        "url": "https://github.com/atomicassets/antelope-ship-utils/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/atomicassets/antelope-ship-utils.git"
    },
    "author": {
        "name": "AtomicHub",
        "url": "https://atomichub.io"
    },
    "keywords": ["antelope", "eosio", "ship", "state-history", "atomicassets", "wax", "eosio-ship-utils"],
    "engines": {
        "node": ">=22"
    },
    "packageManager": "pnpm@11.13.1",
    "files": ["dist/", "NOTICE", "CHANGELOG.md"],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "pretest": "pnpm run build",
        "clean": "rm -rf dist",
        "check-types": "tsc --noEmit -p tsconfig.check.json",
        "lint": "eslint .",
        "test": "mocha 'src/**/*.test.ts'",
        "test:coverage": "c8 mocha 'src/**/*.test.ts'",
        "knip": "knip",
        "prepack": "pnpm run clean && pnpm run build"
    },
    "dependencies": {
        "common-tags": "^1.8.2",
        "@wharfkit/antelope": "^1.1.1",
        "node-worker-threads-pool": "^1.5.1",
        "p-queue": "^6.6.2",
        "ws": "^8.20.1"
    },
    "devDependencies": {
        "@types/common-tags": "^1.8.4",
        "@types/node": "^22",
        "@types/ws": "^8.5.10",
        "@swc-node/register": "^1.11.1",
        "mocha": "^11.7.5",
        "@types/mocha": "^10.0.10",
        "chai": "^6.2.2",
        "@types/chai": "^5.2.3",
        "sinon": "^21.0.1",
        "@types/sinon": "^21.0.0",
        "c8": "11.0.0",
        "typescript": "^6.0.0",
        "eslint": "^9.39.2",
        "@eslint/js": "^9.39.2",
        "typescript-eslint": "^8.59.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.0.0",
        "prettier": "^3.8.0",
        "knip": "^5.88.1"
    }
}
