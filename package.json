{
    "name": "@atomichub/eosio-ship-utils",
    "version": "1.0.0",
    "private": true,
    "description": "EOSIO State History Plugin (SHIP) utilities",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "swc-node": "./src/index.ts",
            "require": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "check-types": "tsc --noEmit",
        "dev": "tsc --watch",
        "clean": "rm -rf dist",
        "lint": "eslint 'src/**/*.ts'",
        "test": "mocha --require @swc-node/register 'src/**/*.test.ts'",
        "test:coverage": "c8 mocha --require @swc-node/register 'src/**/*.test.ts'"
    },
    "dependencies": {
        "common-tags": "^1.8.2",
        "@wharfkit/antelope": "^1.1.1",
        "node-worker-threads-pool": "^1.5.1",
        "p-queue": "^6.6.2",
        "ws": "^8.20.1"
    },
    "devDependencies": {
        "@atomichub/tsconfig": "workspace:*",
        "@types/common-tags": "^1.8.4",
        "@types/node": "^22",
        "@types/ws": "^8.5.10",
        "typescript": "^6.0.0"
    }
}
